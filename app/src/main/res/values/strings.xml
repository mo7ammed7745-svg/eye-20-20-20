    <string name="fullscreen_break">Fullscreen break</string>
    <string name="fullscreen_break_desc">Hide the status and navigation bars when Android allows it.</string>
    <string name="section_system">BACKGROUND &amp; PERMISSIONS</string>
    <string name="notifications_setting">Notifications</string>
    <string name="notifications_setting_desc">Needed for the persistent timer notification and break alerts.</string>
    <string name="fullscreen_alerts">Full-screen break alerts</string>
    <string name="fullscreen_alerts_desc">Some Android versions require special access before an app can show its break screen over other apps.</string>
    <string name="overlay_setting">Display over other apps</string>
    <string name="overlay_setting_desc">Optional. Lets the break screen appear automatically when a break starts, even while you are using another app. The timer works without it. This is the normal Android overlay permission, not accessibility access.</string>
    <string name="battery_setting">Battery optimization</string>
    <string name="battery_setting_desc">For a more reliable background timer, allow unrestricted battery use in Android settings. Android can still stop any app after a force-stop or aggressive restriction.</string>
