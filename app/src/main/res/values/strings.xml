    <!-- First-launch setup -->
    <string name="setup_eyebrow">SETUP</string>
    <string name="setup_title">Keep your breaks on time.</string>
    <string name="setup_subtitle">Android limits background work. These settings help the timer and break screen keep working while you use other apps. You can change them later.</string>
    <string name="setup_recommended">Recommended</string>
    <string name="setup_optional">Optional</string>
    <string name="setup_notifications_title">Notifications</string>
    <string name="setup_notifications_body">The ongoing notification keeps the countdown visible and lets you pause or resume from the notification shade. Android 13 and later asks for notification permission.</string>
    <string name="setup_battery_title">Unrestricted battery use</string>
    <string name="setup_battery_body">Android may delay or stop background timers to save power. Allowing unrestricted battery use for this app makes interruptions less likely. It cannot guarantee that the app will never be stopped.</string>
    <string name="setup_overlay_title">Display over other apps</string>
    <string name="setup_overlay_body">Optional. Lets the break screen open automatically above the app you are using. Without it, a full-screen break alert asks you to tap before the break screen opens. The timer works without this permission.</string>
    <string name="setup_allow_notifications">Allow notifications</string>
    <string name="setup_allow_overlay">Allow over other apps</string>
    <string name="setup_not_set">Not set up</string>
    <string name="setup_finish">Start using Eye 20-20-20</string>
    <string name="setup_skip">Skip for now</string>
    <string name="setup_later_note">You can change these later in Settings → Background &amp; Permissions.</string>
