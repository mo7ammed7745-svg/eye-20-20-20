    <string name="open_notification_settings">Notification settings</string>

    <!-- Settings -->
    <string name="settings_title">Settings</string>
    <string name="settings_subtitle">Saving a new work duration restarts the current work timer. Other changes apply to the next session.</string>
    <string name="section_timer">TIMER</string>
    <string name="work_duration">Work duration</string>
    <string name="work_duration_desc">How long you focus before each eye break. Saving restarts the work timer.</string>
    <string name="break_duration">Break duration</string>
    <string name="break_duration_desc">How long you look away from the screen.</string>
    <string name="grace_duration">Screen-off grace period</string>
    <string name="grace_duration_desc">If the screen stays off longer than this during work, the work timer resets.</string>
    <string name="auto_start">Start the next session automatically</string>
    <string name="auto_start_desc">Begin a new work session as soon as a break ends.</string>
    <string name="allow_break_skipping">Allow skipping breaks</string>
    <string name="allow_break_skipping_desc">Adds a "Continue working" button on the break screen. Off by default so breaks stay protected.</string>
