    <!-- First-launch setup -->
    <string name="setup_eyebrow">الإعداد</string>
    <string name="setup_title">أبقِ استراحاتك في موعدها.</string>
    <string name="setup_subtitle">يقيّد أندرويد العمل في الخلفية. وتساعد هذه الإعدادات المؤقت وشاشة الاستراحة على مواصلة العمل أثناء استخدامك تطبيقات أخرى. يمكنك تغييرها لاحقًا.</string>
    <string name="setup_recommended">موصى به</string>
    <string name="setup_optional">اختياري</string>
    <string name="setup_notifications_title">الإشعارات</string>
    <string name="setup_notifications_body">يُبقي الإشعار الدائم العدّ التنازلي مرئيًا ويتيح لك الإيقاف المؤقت أو الاستئناف من لوحة الإشعارات. ويطلب أندرويد 13 والإصدارات الأحدث إذن الإشعارات.</string>
    <string name="setup_battery_title">استخدام البطارية بلا قيود</string>
    <string name="setup_battery_body">قد يؤخر أندرويد مؤقتات الخلفية أو يوقفها لتوفير الطاقة. والسماح لهذا التطبيق باستخدام البطارية بلا قيود يجعل الانقطاعات أقل احتمالًا. ولا يضمن ذلك ألا يتوقف التطبيق أبدًا.</string>
    <string name="setup_overlay_title">العرض فوق التطبيقات الأخرى</string>
    <string name="setup_overlay_body">اختياري. يتيح فتح شاشة الاستراحة تلقائيًا فوق التطبيق الذي تستخدمه. وبدونه يطلب منك تنبيه بملء الشاشة النقر قبل أن تُفتح شاشة الاستراحة. ويعمل المؤقت بدون هذا الإذن.</string>
    <string name="setup_allow_notifications">السماح بالإشعارات</string>
    <string name="setup_allow_overlay">السماح بالعرض فوق التطبيقات</string>
    <string name="setup_not_set">لم يُضبط بعد</string>
    <string name="setup_finish">ابدأ استخدام Eye 20-20-20</string>
    <string name="setup_skip">تخطَّ الآن</string>
    <string name="setup_later_note">يمكنك تغيير ذلك لاحقًا من الإعدادات ← الخلفية والأذونات.</string>
    <string name="open_settings">فتح الإعدادات</string>
    <string name="open_notification_settings">إعدادات الإشعارات</string>

    <!-- Settings -->
    <string name="settings_title">الإعدادات</string>
    <string name="settings_subtitle">يؤدي حفظ مدة عمل جديدة إلى إعادة تشغيل مؤقت العمل الحالي. وتنطبق التغييرات الأخرى على الجلسة التالية.</string>
    <string name="section_timer">المؤقت</string>
    <string name="work_duration">مدة العمل</string>
    <string name="work_duration_desc">كم تركّز قبل كل استراحة للعين. يؤدي الحفظ إلى إعادة تشغيل مؤقت العمل.</string>
    <string name="break_duration">مدة الاستراحة</string>
    <string name="break_duration_desc">كم تنظر بعيدًا عن الشاشة.</string>
    <string name="grace_duration">مدة السماح عند إطفاء الشاشة</string>
    <string name="grace_duration_desc">إذا ظلت الشاشة مطفأة أثناء العمل أطول من هذه المدة، يُعاد ضبط مؤقت العمل.</string>
    <string name="auto_start">بدء الجلسة التالية تلقائيًا</string>
    <string name="auto_start_desc">تبدأ جلسة عمل جديدة بمجرد انتهاء الاستراحة.</string>
    <string name="allow_break_skipping">السماح بتخطي الاستراحات</string>
    <string name="allow_break_skipping_desc">يضيف زر «متابعة العمل» على شاشة الاستراحة. وهو معطّل افتراضيًا لتبقى الاستراحات محمية.</string>
    <string name="section_break">سلوك الاستراحة</string>
    <string name="vibrate_start">الاهتزاز عند بدء الاستراحة</string>
    <string name="vibrate_end">الاهتزاز عند انتهاء الاستراحة</string>
    <string name="voice_announcements">الإعلانات الصوتية</string>
    <string name="voice_announcements_desc">يشغّل تسجيلًا قصيرًا عند بدء الاستراحة وعند استئناف العمل.</string>
    <string name="announcement_volume">مستوى صوت الإعلانات</string>
    <string name="volume_percent">%1$d٪</string>
    <string name="keep_awake">إبقاء الشاشة مضاءة أثناء الاستراحات</string>
    <string name="keep_awake_desc">يمنع الشاشة من الدخول في وضع السكون أثناء فتح شاشة الاستراحة.</string>
    <string name="fullscreen_break">استراحة بملء الشاشة</string>
    <string name="fullscreen_break_desc">يخفي شريطي الحالة والتنقل عندما يسمح أندرويد بذلك.</string>
    <string name="section_system">الخلفية والأذونات</string>
    <string name="notifications_setting">الإشعارات</string>
    <string name="notifications_setting_desc">مطلوبة لإشعار المؤقت الدائم وتنبيهات الاستراحة.</string>
    <string name="fullscreen_alerts">تنبيهات الاستراحة بملء الشاشة</string>
    <string name="fullscreen_alerts_desc">تتطلب بعض إصدارات أندرويد صلاحية خاصة قبل أن يتمكن التطبيق من عرض شاشة الاستراحة فوق التطبيقات الأخرى.</string>
    <string name="overlay_setting">العرض فوق التطبيقات الأخرى</string>
    <string name="overlay_setting_desc">اختياري. يتيح ظهور شاشة الاستراحة تلقائيًا عند بدء الاستراحة، حتى أثناء استخدامك تطبيقًا آخر. ويعمل المؤقت بدونها. وهذا هو إذن «العرض فوق التطبيقات» المعتاد في أندرويد، وليس إذن إمكانية الوصول.</string>
    <string name="battery_setting">تحسين البطارية</string>
    <string name="battery_setting_desc">لمؤقت خلفية أكثر موثوقية، اسمح باستخدام البطارية بلا قيود من إعدادات أندرويد. ولا يزال بإمكان أندرويد إيقاف أي تطبيق بعد الإيقاف القسري أو القيود الصارمة.</string>
    <string name="open_battery_settings">فتح إعدادات البطارية</string>
    <string name="battery_unrestricted">بلا قيود</string>
    <string name="battery_optimized">محسّن</string>
